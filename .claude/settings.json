{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet slopwatch analyze -d . --hook",
            "timeout": 60,
            "statusMessage": "Checking for slopwatch violations"
          }
        ]
      }
    ]
  }
}
